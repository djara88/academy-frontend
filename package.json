    "admission-queue:audit": "node scripts/admission-queue-audit.mjs",
    "version:write": "node scripts/write-build-version.mjs",
    "prebuild": "npm run brand:audit && npm run orphan:audit && npm run product-dna:audit && npm run competition-cycle:audit && npm run availability-board:audit && npm run attendance-command:audit && npm run staff-board:audit && npm run family-access:audit && npm run professor-tactical-board:audit && npm run kit-room:audit && npm run sport-enrollment:audit && npm run admission-queue:audit && npm run version:write",
