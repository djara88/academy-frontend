{
  "name": "syncademia-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "brand:audit": "node scripts/brand-audit.mjs",
    "orphan:audit": "node scripts/orphan-audit.mjs",
    "product-dna:audit": "node scripts/product-dna-audit.mjs",
    "competition-cycle:audit": "node scripts/competition-cycle-audit.mjs",
    "availability-board:audit": "node scripts/availability-board-audit.mjs",
    "attendance-command:audit": "node scripts/attendance-command-audit.mjs",
    "staff-board:audit": "node scripts/staff-board-audit.mjs",
    "family-access:audit": "node scripts/family-access-audit.mjs",
